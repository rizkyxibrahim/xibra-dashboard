# Base URL of xibra-api. Server-side only; never exposed to the browser.
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Required in production: at least 32 characters.
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# In development, leave this unset: Nuxt generates and persists a local secret.
# NUXT_APP_SECRET=